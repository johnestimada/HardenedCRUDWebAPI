    {
      "name": "Part 3 - Conflict + Global handler",
      "item": [
        {
          "name": "3.1 Duplicate SKU, different case -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Content-Type is application/problem+json\", function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });",
                  "pm.test(\"Title is Conflict\", function () { pm.expect(pm.response.json().title).to.eql('Conflict'); });",
                  "pm.test(\"No stack trace leaks to the client\", function () { const b = pm.response.text(); pm.expect(b).to.not.include('StackTrace'); pm.expect(b).to.not.match(/\\sat\\s[\\w.]+\\(/); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Another Keyboard\",\n  \"sku\": \"key-001\",\n  \"price\": 60\n}"
            }
          }
        },
        {
          "name": "3.2 Missing id -> 404 Problem Details",
          "event": [
