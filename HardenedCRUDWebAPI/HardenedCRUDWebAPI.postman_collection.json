  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5250"
    },
    {
      "key": "keyboardId",
      "value": ""
    },
    {
      "key": "mouseId",
      "value": ""
    },
    {
      "key": "monitorId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Part 1 - Data Annotations (400)",
      "item": [
        {
          "name": "1.1 Empty name, empty sku, negative price -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Content-Type is application/problem+json\", function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });",
                  "pm.test(\"errors lists: Name, SKU, Price\", function () { const e = Object.keys(pm.response.json().errors).map(k => k.toLowerCase()); pm.expect(e).to.include(\"name\"); pm.expect(e).to.include(\"sku\"); pm.expect(e).to.include(\"price\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"sku\": \"\",\n  \"price\": -5\n}"
            }
          }
        },
