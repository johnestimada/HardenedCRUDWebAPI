                "exec": [
                  "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Content-Type is application/problem+json\", function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });",
                  "pm.test(\"Title + traceId present\", function () { const j = pm.response.json(); pm.expect(j.title).to.eql('Resource Not Found'); pm.expect(j.traceId).to.be.a('string'); pm.expect(j.status).to.eql(404); });",
                  "pm.test(\"No stack trace leaks to the client\", function () { const b = pm.response.text(); pm.expect(b).to.not.include('StackTrace'); pm.expect(b).to.not.match(/\\sat\\s[\\w.]+\\(/); });"
                ]
              }
